/* =========================
   LOGIN
========================= */

function Login() {
  return (
    <>
      <Navbar />

      <main className="login-page">

        <div className="login-container">

          <h1>
            Login
          </h1>

          <input
            type="text"
            placeholder="Username"
          />

          <input
            type="password"
            placeholder="Password"
          />

          <button>
            Log In
          </button>

        </div>

      </main>

      <Footer />
    </>
  );
}


/* =========================
   APP
========================= */

function App() {
  return (
    <BrowserRouter>

      <Routes>

        <Route path="/" element={<Home />} />

        <Route path="/blog" element={<Blog />} />

        <Route
          path="/write-post"
          element={<WritePost />}
        />

        <Route
          path="/must-do"
          element={<MustDo />}
        />

        <Route
          path="/community"
          element={<Community />}
        />

        <Route
          path="/search"
          element={<Search />}
        />

        <Route
          path="/login"
          element={<Login />}
        />

      </Routes>

    </BrowserRouter>
  );
}

export default App;