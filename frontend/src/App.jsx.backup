          </div>

        </section>

      </main>

      <Footer />
    </>
  );
}


/* =========================
   POST CARD
========================= */

function PostCard({
  category,
  title,
  description,
  tags
}) {
  return (
    <article className="post-card">

      <div className="post-category">
        {category}
      </div>

      <h3>
        {title}
      </h3>

      <div className="post-author">
        By Pratham
      </div>

      <p>
        {description}
      </p>

      <div className="post-tags">
        {tags}
      </div>

      <Link to="#" className="read-more">
        Read more →
      </Link>

    </article>
  );
}


