# Copy this file to .env and fill in your own values.
# .env is gitignored and must never be committed.

# MongoDB Atlas connection string, ending with the database name.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/migranthub

# Database used when NODE_ENV=test, so "npm test" never touches the
# data above. The same cluster with a different database name is fine.
MONGO_URI_TEST=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/migranthub_test

# Port the API listens on.
PORT=4000

# Any long random string. Used to sign JWTs.
JWT_SECRET=

# Google AI Studio key for the post enrichment feature.
# The app still works without it: enrichment is skipped.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
